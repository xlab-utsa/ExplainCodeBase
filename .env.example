# vLLM server (the default LLM for every command)
VLLM_API_BASE=http://localhost:8000/v1
# Leave VLLM_MODEL empty to use whichever model the server serves.
VLLM_MODEL=
VLLM_API_KEY=EMPTY
# Optional tuning
# VLLM_MAX_TOKENS=2048
# VLLM_TEMPERATURE=0.2
# VLLM_TIMEOUT=600
# VLLM_MAX_MODEL_LEN=32768   # only if the server does not report max_model_len

# Optional hosted providers
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=            # or PROJECT_ID + VERTEX_LOCATION for Vertex AI
# ANTHROPIC_MODEL=claude-sonnet-5-5
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
